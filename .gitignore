.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
outputs/
.DS_Store

# Model weights are pulled locally; only small config/tokenizer files are committable
weights/**/*.safetensors
weights/**/*.ckpt
weights/**/*.bin
weights/**/*.pt
weights/**/*.pth
weights/**/*.onnx
weights/**/.cache/

# Geneformer ships its gene dictionaries as pickles; stage them from the pinned revision instead
# of vendoring them (they are digest-verified and loaded through RestrictedUnpickler).
weights/**/*.pkl
